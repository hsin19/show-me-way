# Copy to `.env` (gitignored) for a self-hosted deployment. Nothing here is a secret —
# every VITE_ value is inlined into the published bundle.

# Google OAuth client id behind the Drive sync feature.
#
# Optional, and that is the trap: with no value the app falls back to a hardcoded id in
# src/lib/infra/http/gdrive.ts that is tied to THIS repo's authorized JavaScript origins, so a fork
# or a different domain fails at sign-in with an error that says nothing about why.
#
# To get one: Google Cloud console → APIs & Services → Credentials → Create credentials →
# OAuth client ID → Web application. Enable the Google Drive API on the same project, and
# add your origin (e.g. https://you.github.io) under "Authorized JavaScript origins".
# The app requests drive.file plus userinfo.email / userinfo.profile.
VITE_GOOGLE_CLIENT_ID=

# Base URL of the hop instance the encrypted short share link uploads to. Optional;
# blank or absent falls back to https://hop.hsin19.com (src/lib/infra/http/hop.ts).
# Point it at a local hop when developing the share flow. Only ciphertext ever goes
# there — the key stays in the URL fragment — so a self-host does not change what the
# server can read, only who operates it. A trailing slash is tolerated.
VITE_HOP_BASE_URL=

# Not settable here: `BASE_PATH` (the sub-path GitHub Pages serves the project site from)
# and `VITE_GIT_SHA` (the commit stamped into the About section) are read by
# vite.config.ts through `process.env`, which Vite does not populate from this file.
# Pass them on the build command instead — .github/workflows/deploy.yml does.
