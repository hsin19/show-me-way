{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "下面一way 行程 Schema",
  "type": "object",
  "properties": {
    "trip": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "行程名稱"
        },
        "id": {
          "type": "string",
          "description": "[自動產生 / 請勿手動編輯] App 產生的行程識別碼，會跟著匯出檔、分享連結與雲端備份走，用來認出「同一趟行程」。手動修改或刪除會讓這趟行程與它的雲端檔案失去關聯。",
          "readOnly": true
        },
        "start": {
          "type": "string",
          "description": "[已過時 / Deprecated] 不需填寫。App 會自動取 days 中最早的 date 作為出發日期。",
          "deprecated": true
        },
        "end": {
          "type": "string",
          "description": "[已過時 / Deprecated] 不需填寫。App 會自動取 days 中最晚的 date 作為回程日期。",
          "deprecated": true
        },
        "departure": {
          "type": "string",
          "description": "[已過時 / Deprecated] 不需填寫。App 會自動以第一天的第一個行程時間作為首頁倒數計時的目標。",
          "deprecated": true
        },
        "lang": {
          "type": "string",
          "description": "目的地語言代碼，用於選擇內建的實用常用語與計程車司機提示 (ko=韓文, ja=日文, en=英文)。未設定或不支援時預設為英文 (en)。",
          "enum": [
            "ko",
            "ja",
            "en"
          ]
        },
        "currency": {
          "type": "string",
          "description": "記帳功能使用的貨幣代碼 (例如: KRW, JPY, USD)。未設定時預設為 TWD。"
        },
        "mapProvider": {
          "enum": [
            "naver",
            "google"
          ],
          "type": "string",
          "description": "地圖搜尋使用的服務 (選填)。韓國因地圖法規建議設 naver，未設定時預設使用 Google Maps。"
        },
        "city": {
          "type": "string",
          "description": "目的地城市，用於查詢每日天氣預報 (選填，未設定或留空字串時不顯示天氣)。建議使用英文名稱 (例如: Tokyo, Seoul, Osaka)；中文名稱僅部分可查 (東京、京都可，首爾、大阪、釜山等查不到或比對錯國家)。同名城市可加兩碼國碼後綴消歧 (例如: 'Springfield, US')。可在個別 day 以 city 覆蓋 (多城市行程)。"
        },
        "wallets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "記帳使用的自訂電子錢包/卡片清單 (例如: Suica, WOWPASS。現金預設會自動存在)"
        },
        "hotels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "飯店/旅宿名稱"
              },
              "address": {
                "type": "string",
                "description": "飯店外文地址 (供計程車司機觀看/複製)"
              },
              "checkIn": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "入住日期 (YYYY-MM-DD)"
              },
              "checkOut": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "退房日期 (YYYY-MM-DD)"
              },
              "localName": {
                "type": "string",
                "description": "地點的當地語言名稱，作為地圖搜尋關鍵字 (點擊按鈕開啟地圖/複製)"
              },
              "mapLink": {
                "type": "string",
                "description": "地圖直接連結 (如 naver.me / maps.app.goo.gl 短網址)。有設定時會優先使用，比關鍵字搜尋更精準。"
              },
              "confirmation": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "訂位/訂房確認碼或訂單編號。純數字代碼請加引號 (例如 '012345')，避免被解析成數字而遺失前導零。"
                  },
                  "name": {
                    "type": "string",
                    "description": "訂位人姓名 (選填)，建議與護照拼音一致。"
                  },
                  "note": {
                    "type": "string",
                    "description": "補充備註 (選填)，例如「入住/報到時出示護照」。"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false,
                "description": "訂位/訂房確認資訊 (選填)。設定後卡片會顯示確認碼 chip，點一下複製，並可放大出示給櫃台。"
              }
            },
            "required": [
              "name",
              "address",
              "checkIn",
              "checkOut"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "hotels"
      ],
      "additionalProperties": false
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "integer",
            "description": "[已過時 / Deprecated] 不需填寫。App 會依 date 排序後自動編號。",
            "deprecated": true
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "當天日期 (YYYY-MM-DD)"
          },
          "title": {
            "type": "string",
            "description": "當日行程大標題/主題，例如: 抵達 · 新宿、京都一日遊。建議 14 個全形字以內 (約 23 個半形字)：在 390px 寬的手機上，日程卡大標題超過就會折成兩行；總覽日期清單則會在 15 個全形字處截字。",
            "maxLength": 24
          },
          "region": {
            "type": "string",
            "description": "[已過時 / Deprecated] 舊版區域屬性，請改用 title",
            "deprecated": true
          },
          "pace": {
            "type": "string",
            "description": "今日行程節奏描述 (選填，預設為「自由安排行程」)，例如: 慢活、需要早起。建議 15 個全形字以內 (約 27 個半形字)。",
            "maxLength": 30
          },
          "city": {
            "type": "string",
            "description": "當日所在城市，覆蓋 trip.city 的天氣查詢 (選填，多城市行程用)。建議使用英文名稱 (例如: Kyoto)，可加兩碼國碼後綴消歧 (例如: 'Springfield, US')。留空字串視同未設定，回退至 trip.city。"
          },
          "timeline": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string",
                  "description": "時間區間，例如: 14:00 - 15:30"
                },
                "title": {
                  "type": "string",
                  "description": "行程或事件標題"
                },
                "type": {
                  "enum": [
                    "booked",
                    "must-go",
                    "standard",
                    "option"
                  ],
                  "type": "string",
                  "description": "事件類型：booked(預訂/橘色), must-go(必訪/粉色), standard(一般/藍色), option(備選/紫色)"
                },
                "desc": {
                  "type": "string",
                  "description": "詳細說明描述，支援行內 Markdown：[說明](https://…)、**粗體**、*斜體*、`等寬`"
                },
                "status": {
                  "enum": [
                    "done",
                    "skipped"
                  ],
                  "type": "string",
                  "description": "打卡狀態 (選填)：done=已完成, skipped=略過。未設定表示尚未造訪。通常由 App 內的打卡按鈕寫入，並隨 YAML 與分享連結保留進度。"
                },
                "bullets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "備註條列式項目，支援行內 Markdown：[說明](https://…)、**粗體**、*斜體*、`等寬`（不支援 HTML）"
                },
                "localName": {
                  "type": "string",
                  "description": "地點的當地語言名稱，作為地圖搜尋關鍵字 (點擊按鈕開啟地圖/複製)"
                },
                "mapLink": {
                  "type": "string",
                  "description": "地圖直接連結 (如 naver.me / maps.app.goo.gl 短網址)。有設定時會優先使用，比關鍵字搜尋更精準。"
                },
                "confirmation": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "訂位/訂房確認碼或訂單編號。純數字代碼請加引號 (例如 '012345')，避免被解析成數字而遺失前導零。"
                    },
                    "name": {
                      "type": "string",
                      "description": "訂位人姓名 (選填)，建議與護照拼音一致。"
                    },
                    "note": {
                      "type": "string",
                      "description": "補充備註 (選填)，例如「入住/報到時出示護照」。"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false,
                  "description": "訂位/訂房確認資訊 (選填)。設定後卡片會顯示確認碼 chip，點一下複製，並可放大出示給櫃台。"
                },
                "stops": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "地點顯示名稱 (通常是中文，例如「特雷維噴泉」)"
                      },
                      "localName": {
                        "type": "string",
                        "description": "地點的當地語言名稱 (選填，例如 'Fontana di Trevi')，可放大出示問路，也作為地圖搜尋關鍵字。沒有這個欄位 (也沒有 mapLink) 的話該站不會有地圖按鈕，所以建議填。"
                      },
                      "mapLink": {
                        "type": "string",
                        "description": "地圖直接連結 (選填，如 maps.app.goo.gl 短網址)。有設定時會優先使用，比關鍵字搜尋更精準。"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  "description": "本事件依序走訪的多個地點 (選填)，例如「西班牙階梯 ➔ 特雷維噴泉 ➔ 萬神殿」這種串聯行程。每站各自產生地圖與放大按鈕，所以每一站都能放大出示問路，不像事件層的 localName 只能有一個。在事件卡上直接展開顯示 (不折疊)，因為這是行程主體。若是「擇一前往」的備選地點請用 alternatives；若只是官網、攻略文等補充網址請用 links。"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "description": "連結顯示文字"
                      },
                      "url": {
                        "type": "string",
                        "description": "連結網址：http(s)、mailto:、tel:、sms:、geo: 或裸網域 (會自動補 https://)。其他 scheme 不會顯示連結"
                      }
                    },
                    "required": [
                      "label",
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  "description": "同一事件的補充連結 (選填)，例如官網、攻略文。地圖連結會自動顯示對應的品牌 icon。若要列出本事件走訪的多個地點請改用 stops (每站會有地圖與放大按鈕)；若是「擇一前往」的備選地點 (如備案餐廳) 請改用 alternatives。"
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "description": "備選地點名稱"
                      },
                      "localName": {
                        "type": "string",
                        "description": "地點的當地語言名稱 (選填)，可放大出示問路，也作為地圖搜尋關鍵字"
                      },
                      "mapLink": {
                        "type": "string",
                        "description": "地圖直接連結 (如 naver.me / maps.app.goo.gl 短網址)。有設定時會優先使用，比關鍵字搜尋更精準。"
                      },
                      "note": {
                        "type": "string",
                        "description": "換點決策備註 (選填)，例如「排隊超過 30 分鐘就換」。支援行內 Markdown：[說明](https://…)、**粗體**、*斜體*、`等寬`"
                      }
                    },
                    "required": [
                      "title"
                    ],
                    "additionalProperties": false
                  },
                  "description": "備選地點清單 (選填)，例如備案餐廳：每筆是一個候選地點，含當地語言店名 (可放大出示問路) 與備註 (如「排隊超過 30 分鐘就換」)，供現場換點決策。在事件卡尾端以折疊清單顯示。若只是同一事件的補充連結或多個點，請改用 links。"
                }
              },
              "required": [
                "time",
                "title",
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "date",
          "title",
          "timeline"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "每日行程細節列表 (順序不敏感，系統會自動按日期排序並補齊中間空白天)"
    },
    "todo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "項目文字，支援行內 Markdown：[說明](https://…)、**粗體**、*斜體*、`等寬`"
          },
          "checked": {
            "type": "boolean",
            "description": "是否已勾選 (選填，預設 false)。App 會隨勾選狀態寫回這個欄位。"
          },
          "id": {
            "type": "string",
            "description": "[已過時 / Deprecated] 舊版項目識別碼，App 存檔時會移除。",
            "deprecated": true
          }
        },
        "additionalProperties": false
      },
      "description": "行前待辦清單"
    },
    "packing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "項目文字，支援行內 Markdown：[說明](https://…)、**粗體**、*斜體*、`等寬`"
          },
          "checked": {
            "type": "boolean",
            "description": "是否已勾選 (選填，預設 false)。App 會隨勾選狀態寫回這個欄位。"
          },
          "id": {
            "type": "string",
            "description": "[已過時 / Deprecated] 舊版項目識別碼，App 存檔時會移除。",
            "deprecated": true
          }
        },
        "additionalProperties": false
      },
      "description": "隨身行李與打包清單"
    },
    "expenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "消費項目名稱"
          },
          "amount": {
            "type": "number",
            "description": "金額 (當地幣別整數)"
          },
          "type": {
            "type": "string",
            "description": "支付方式：錢包/卡片名稱、Cash，或加值 Deposit-<錢包> / Deposit-Cash"
          },
          "date": {
            "type": "string",
            "description": "日期 (YYYY-MM-DD)"
          }
        },
        "required": [
          "name",
          "amount",
          "type",
          "date"
        ],
        "additionalProperties": false
      },
      "description": "記帳消費紀錄 (通常由 App 自動維護，亦可手動編輯)"
    }
  },
  "required": [
    "trip",
    "days"
  ],
  "additionalProperties": false
}
