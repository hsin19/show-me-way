{
  "name": "show-me-way",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "typecheck:fast": "node -e \"fs.rmSync('.svelte-check',{recursive:true,force:true})\" && svelte-check --tsgo --tsconfig ./tsconfig.app.json && tsgo -p tsconfig.node.json",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-report.junit.xml",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "knip:fix": "knip --fix --fix-type exports,types --format",
    "knip:ci": "knip --exclude dependencies,devDependencies --no-config-hints",
    "check": "pnpm run format && pnpm run knip:fix && pnpm run lint:fix && pnpm run typecheck && pnpm run test && pnpm run build && E2E_SKIP_BUILD=1 pnpm run test:e2e",
    "check:ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run knip:ci && pnpm run test:ci && pnpm run build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "dprint fmt --allow-no-files",
    "*.{js,ts,svelte}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.28.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@typescript/native-preview": "7.0.0-dev.20260610.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dprint": "^0.55.2",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "js-yaml": "^5.2.3",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0"
  }
}
