{
  "name": "show-me-way",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "schema:gen": "node --import ./scripts/resolve-hooks.ts scripts/gen-schema.ts",
    "schema:check": "node --import ./scripts/resolve-hooks.ts scripts/gen-schema.ts --check",
    "trip:sync": "node --import ./scripts/resolve-hooks.ts scripts/trip-sync.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=github-actions --reporter=junit --outputFile.junit=test-report.junit.xml",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "knip:fix": "knip --fix --fix-type exports,types --format",
    "knip:ci": "knip --exclude dependencies,devDependencies --no-config-hints",
    "check": "pnpm run schema:gen && pnpm run format && pnpm run knip:fix && pnpm run lint:fix && pnpm run typecheck && pnpm run test && pnpm run build && E2E_SKIP_BUILD=1 pnpm run test:e2e",
    "ci": "pnpm run schema:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run knip:ci && pnpm run test && pnpm run build",
    "skills:update": "pnpm dlx skills update",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "src/lib/domain/trip-schema.ts": "pnpm run schema:gen",
    "*": "dprint fmt --allow-no-files",
    "*.{js,ts,svelte}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.47.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.6",
    "@valibot/to-json-schema": "^1.8.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dprint": "^0.57.4",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "js-yaml": "^5.4.2",
    "valibot": "^1.5.0"
  }
}
