{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": {
      "$lib/*": ["./src/lib/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * `src/vite-env.d.ts` is here because e2e specs import from `src/lib/` (share.spec.ts
   * and gdrive.spec.ts both do, rather than restating an algorithm they need to agree
   * with). That pulls those modules into THIS project, which has no `vite/client`, so
   * without the ambient declarations an `import.meta.env` read in any of them fails to
   * compile here while being fine under tsconfig.app.json.
   */
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "pwa-assets.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "src/vite-env.d.ts"
  ]
}
